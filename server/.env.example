PORT=3001

# --- Supabase (Trek Builder / authored daily treks) ---
# Copy this file to `server/.env` and fill these in from your Supabase project
# (Project Settings -> API). `.env` is gitignored; never commit real values.

# https://<ref>.supabase.co
SUPABASE_URL=

# The SECRET "service_role" key (NOT the anon key) — a long "eyJ..." JWT from
# Project Settings -> API. Treat it like a password: local .env here, a Fly
# secret in production. Never ship it to the browser.
SUPABASE_SERVICE_KEY=

PORT=3001

# Phase 2 — Supabase (real daily percentile). The service_role key BYPASSES RLS;
# keep it server-only (this file is an EXAMPLE — put real values in server/.env,
# which is gitignored). Leave blank to run offline (synthetic percentile).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Phase 3 — Trek Builder admin token. When set, the /daily/admin/* routes mount
# (dev authoring) and require this value as the `x-admin-token` header. Leave
# blank in production so no admin surface exists.
DAILY_ADMIN_TOKEN=

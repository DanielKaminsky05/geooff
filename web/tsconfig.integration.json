{
  // Client integration tests (npm run test:integration). They import the real
  // game server from ../server/src, whose code uses non-erasable syntax
  // (parameter properties), so they get their own project. Deliberately NOT a
  // reference of tsconfig.json: `tsc -b` (npm run build, Vercel) must not need
  // server/node_modules. Checked by `npm run test:integration` instead.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.integration.tsbuildinfo",
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "erasableSyntaxOnly": false
  },
  "include": ["src/test/integration"],
  "exclude": []
}
